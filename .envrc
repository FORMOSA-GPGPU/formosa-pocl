# Load the PoCL toolchain from the FORMOSA monorepo. Local paths belong in
# .envrc.local; see .envrc.local.example.

POCL_ROOT="$(pwd -P)"
source_env_if_exists ./.envrc.local

if [[ -z ${FORMOSA_SOURCE_DIR:-} ]]; then
  log_error "FORMOSA_SOURCE_DIR is required; set it in .envrc.local"
  return 1
fi
if [[ ! -f $FORMOSA_SOURCE_DIR/flake.nix ]]; then
  log_error "FORMOSA_SOURCE_DIR has no flake.nix: $FORMOSA_SOURCE_DIR"
  return 1
fi

export FORMOSA_SOURCE_DIR="$(cd "$FORMOSA_SOURCE_DIR" && pwd -P)"
watch_file "$FORMOSA_SOURCE_DIR/flake.nix"
watch_file "$FORMOSA_SOURCE_DIR/formosa-pocl/formosa-pocl.nix"
use flake "path:$FORMOSA_SOURCE_DIR#formosa-pocl"

if [[ -n ${FORMOSA_INSTALL_PREFIX:-} ]]; then
  if [[ ! -d $FORMOSA_INSTALL_PREFIX ]]; then
    log_error "FORMOSA_INSTALL_PREFIX is not a directory: $FORMOSA_INSTALL_PREFIX"
    return 1
  fi
  export FORMOSA_INSTALL_PREFIX="$(realpath "$FORMOSA_INSTALL_PREFIX")"

  formosa_config_dir=""
  for formosa_libdir in lib lib64; do
    candidate="$FORMOSA_INSTALL_PREFIX/$formosa_libdir/cmake/Formosa"
    if [[ -f $candidate/FormosaConfig.cmake ]]; then
      formosa_config_dir="$candidate"
      break
    fi
  done
  if [[ -z $formosa_config_dir ]]; then
    log_error "FORMOSA_INSTALL_PREFIX has no FormosaConfig.cmake: $FORMOSA_INSTALL_PREFIX"
    return 1
  fi

  export cmakeFlags="${cmakeFlags:-} -D Formosa_DIR=$formosa_config_dir"
  formosa_override_warning="[WARNING] FORMOSA LOCAL SDK OVERRIDE ACTIVE"
  [[ -t 2 ]] && formosa_override_warning=$'\033[1;33m'"$formosa_override_warning"$'\033[0m'
  log_status "$formosa_override_warning"
  log_status "  FORMOSA SDK: $FORMOSA_INSTALL_PREFIX"
fi

if [[ -n ${FORMOSA_LLVM_PREFIX:-} ]]; then
  if [[ ! -d $FORMOSA_LLVM_PREFIX ]]; then
    log_error "FORMOSA_LLVM_PREFIX is not a directory: $FORMOSA_LLVM_PREFIX"
    return 1
  fi
  export FORMOSA_LLVM_PREFIX="$(realpath "$FORMOSA_LLVM_PREFIX")"
  for formosa_llvm_tool in llvm-config clang ld.lld; do
    if [[ ! -x $FORMOSA_LLVM_PREFIX/bin/$formosa_llvm_tool ]]; then
      log_error "local LLVM is missing bin/$formosa_llvm_tool: $FORMOSA_LLVM_PREFIX"
      return 1
    fi
  done
  formosa_llvm_libdir="$("$FORMOSA_LLVM_PREFIX/bin/llvm-config" --libdir)" || return 1
  PATH_add "$FORMOSA_LLVM_PREFIX/bin"
  path_add LD_LIBRARY_PATH "$formosa_llvm_libdir"
  path_add DYLD_LIBRARY_PATH "$formosa_llvm_libdir"
  export cmakeFlags="${cmakeFlags:-} -DWITH_LLVM_CONFIG=$FORMOSA_LLVM_PREFIX/bin/llvm-config -DCMAKE_INSTALL_RPATH=$formosa_llvm_libdir"
  formosa_override_warning="[WARNING] FORMOSA LOCAL LLVM OVERRIDE ACTIVE"
  [[ -t 2 ]] && formosa_override_warning=$'\033[1;33m'"$formosa_override_warning"$'\033[0m'
  log_status "$formosa_override_warning"
  log_status "  LLVM: $FORMOSA_LLVM_PREFIX"
fi

if [[ -n ${FORMOSA_RUNTIME_PREFIX:-} ]]; then
  if [[ ! -d $FORMOSA_RUNTIME_PREFIX ]]; then
    log_error "FORMOSA_RUNTIME_PREFIX is not a directory: $FORMOSA_RUNTIME_PREFIX"
    return 1
  fi
  export FORMOSA_RUNTIME_PREFIX="$(realpath "$FORMOSA_RUNTIME_PREFIX")"
  for formosa_runtime_file in \
    riscv64-unknown-elf/include/stdio.h \
    riscv64-unknown-elf/lib/libc.a \
    riscv64-unknown-elf/lib/libm.a \
    riscv64-unknown-elf/lib/libgloss.a \
    lib/clang/current/include/stddef.h \
    lib/clang/current/include/opencl-c.h \
    lib/clang/current/include/opencl-c-base.h \
    lib/clang/current/lib/riscv64-unknown-unknown-elf/libclang_rt.builtins.a; do
    if [[ ! -f $FORMOSA_RUNTIME_PREFIX/$formosa_runtime_file ||
          ! -r $FORMOSA_RUNTIME_PREFIX/$formosa_runtime_file ]]; then
      log_error "local runtime is missing a readable $formosa_runtime_file: $FORMOSA_RUNTIME_PREFIX"
      return 1
    fi
  done
  formosa_override_warning="[WARNING] FORMOSA LOCAL RUNTIME OVERRIDE ACTIVE"
  [[ -t 2 ]] && formosa_override_warning=$'\033[1;33m'"$formosa_override_warning"$'\033[0m'
  log_status "$formosa_override_warning"
  log_status "  Runtime: $FORMOSA_RUNTIME_PREFIX"
fi

if [[ -n ${FORMOSA_LLVM_PREFIX:-} || -n ${FORMOSA_RUNTIME_PREFIX:-} ]]; then
  # Keep each compiler configuration at its own persistent path so changing
  # the override or clearing .direnv cannot change an installed PoCL's compiler.
  # Empty overrides select the wrapper's Nix defaults, overriding the caller.
  formosa_clang_wrapper="$(command -v formosa-clang)" || return 1
  formosa_clang_script="$(printf '#!%s\nexport FORMOSA_LLVM_PREFIX=%q\nexport FORMOSA_RUNTIME_PREFIX=%q\nexec %q "$@"\n' \
    "$(command -v bash)" "${FORMOSA_LLVM_PREFIX:-}" "${FORMOSA_RUNTIME_PREFIX:-}" \
    "$formosa_clang_wrapper")" || return 1
  formosa_clang_hash="$(printf '%s\n' "$formosa_clang_script" | sha256sum)" || return 1
  formosa_clang_path="$POCL_ROOT/outputs/toolchains/formosa-clang-${formosa_clang_hash%% *}"
  if [[ ! -x $formosa_clang_path ]]; then
    mkdir -p "$POCL_ROOT/outputs/toolchains" || return 1
    formosa_clang_tmp="$(mktemp "$POCL_ROOT/outputs/toolchains/.formosa-clang.XXXXXX")" || return 1
    if ! { printf '%s\n' "$formosa_clang_script" > "$formosa_clang_tmp" &&
           chmod +x "$formosa_clang_tmp" &&
           mv -f "$formosa_clang_tmp" "$formosa_clang_path"; }; then
      rm -f "$formosa_clang_tmp"
      return 1
    fi
  fi
  export cmakeFlags="${cmakeFlags:-} -DFORMOSA_CLANG_PATH=$formosa_clang_path"
fi

export POCL_INSTALL_PREFIX="${POCL_INSTALL_PREFIX:-$POCL_ROOT/outputs/out}"
export CMAKE_INSTALL_PREFIX="$POCL_INSTALL_PREFIX"
export OCL_ICD_VENDORS="$POCL_INSTALL_PREFIX/etc/OpenCL/vendors/pocl.icd"
export AGENT_SOCKET_PATH="${AGENT_SOCKET_PATH:-/tmp/formosa.sock}"
export cmakeFlags="${cmakeFlags:-} -D CMAKE_INSTALL_PREFIX=$POCL_INSTALL_PREFIX"
