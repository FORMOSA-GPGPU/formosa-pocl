# Load the formosa-pocl Nix build shell from the formosa monorepo.
#
# Resolution order:
#   1. FORMOSA_FLAKE — absolute path to a formosa clone (optional override)
#   2. Sibling only: <parent-of-this-pocl> / formosa / flake.nix
#
# No recursive parent walk: discovery stops at the directory next to pocl.

POCL_ROOT="$(pwd -P)"
# Pass the local PoCL source to the impure Formosa flake.
export FORMOSA_POCL_SRC="${FORMOSA_POCL_SRC:-${POCL_ROOT}}"

if [ -n "${FORMOSA_FLAKE:-}" ]; then
  if [ ! -f "${FORMOSA_FLAKE}/flake.nix" ]; then
    echo "direnv: FORMOSA_FLAKE is set but flake.nix is missing:" >&2
    echo "direnv:   FORMOSA_FLAKE=${FORMOSA_FLAKE}" >&2
    echo "direnv: expected: \${FORMOSA_FLAKE}/flake.nix" >&2
    return 1
  fi
  FORMOSA_DIR="$(cd "${FORMOSA_FLAKE}" && pwd -P)"
else
  SIBLING="$(cd "${POCL_ROOT}/.." && pwd -P)/formosa"
  if [ -f "${SIBLING}/flake.nix" ]; then
    FORMOSA_DIR="${SIBLING}"
  else
    echo "direnv: cannot find formosa monorepo next to this pocl checkout." >&2
    echo "direnv: looked for: ${SIBLING}/flake.nix" >&2
    echo "direnv: layout expected:" >&2
    echo "direnv:   <parent>/" >&2
    echo "direnv:     formosa/   # flake with #formosa-pocl" >&2
    echo "direnv:     pocl/      # this repo" >&2
    echo "direnv: or set FORMOSA_FLAKE to the absolute path of your formosa clone:" >&2
    echo "direnv:   export FORMOSA_FLAKE=/absolute/path/to/formosa" >&2
    echo "direnv: then re-enter this directory (or: direnv allow)." >&2
    return 1
  fi
fi

echo "direnv: using formosa at ${FORMOSA_DIR}" >&2

watch_file "${FORMOSA_DIR}/flake.nix"
watch_file "${FORMOSA_DIR}/formosa-pocl/formosa-pocl.nix"
use flake "path:${FORMOSA_DIR}#formosa-pocl" --impure

# Local debug install / device source (set after use flake so we win over the
# formosa package shell defaults when they differ).
export FORMOSA_SOURCE_DIR="${FORMOSA_DIR}"
export CMAKE_INSTALL_PREFIX="${FORMOSA_DIR}/outputs/out"
export OCL_ICD_VENDORS="${CMAKE_INSTALL_PREFIX}/etc/OpenCL/vendors/pocl.icd"
export AGENT_SOCKET_PATH="/tmp/formosa.sock"

# Prefer a Debug build against the monorepo formosa sources.
export cmakeFlags="${cmakeFlags:-} -D CMAKE_BUILD_TYPE=Debug -D FORMOSA_SOURCE_DIR=${FORMOSA_SOURCE_DIR} -D CMAKE_INSTALL_PREFIX=${CMAKE_INSTALL_PREFIX}"
