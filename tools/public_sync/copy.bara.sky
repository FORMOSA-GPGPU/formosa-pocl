GITLAB_REPO = "git@git.caslab.ee.ncku.edu.tw:formosa-gpgpu/pocl.git"
GITHUB_REPO = "git@github.com:FORMOSA-GPGPU/formosa-pocl.git"

INTERNAL_ONLY_EXCLUDES = [
    ".gitlab-ci.yml",
    ".gitlab/**",
    "tools/public_sync/**",
]

PUBLIC_TRANSFORMATIONS = [
    metadata.scrubber(
        "(git@|ssh://git@|https://)([A-Za-z0-9_.-]+\\.)?(caslab|elite)\\.ee\\.ncku\\.edu\\.tw[:/][^\\s)\\]]*",
        replacement = "FORMOSA internal repository",
    ),
    metadata.scrubber(
        "([A-Za-z0-9_.-]+\\.)?(caslab|elite)\\.ee\\.ncku\\.edu\\.tw[:/][^\\s)\\]]*",
        replacement = "FORMOSA internal repository",
    ),
    core.transform([
        core.replace(
            before = "ssh://git@git.caslab.ee.ncku.edu.tw/formosa-gpgpu/formosa-llvm.git",
            after = "https://github.com/FORMOSA-GPGPU/formosa-llvm.git",
            paths = glob(["flake.lock"]),
        ),
        core.replace(
            before = "${internal_formosa_llvm_url}",
            after = "https://github.com/FORMOSA-GPGPU/formosa-llvm.git",
            regex_groups = {
                "internal_formosa_llvm_url": "(git@|ssh://git@|https://)(git\\.caslab|elite)\\.ee\\.ncku\\.edu\\.tw[:/][^\\s\"')]*formosa-llvm(\\.git)?",
            },
            paths = glob(["**"]),
        ),
        core.replace(
            before = "https://git.caslab.ee.ncku.edu.tw/formosa-gpgpu/formosa",
            after = "https://github.com/FORMOSA-GPGPU/formosa",
            paths = glob(["README.formosa.md"]),
        ),
        core.replace(
            before = "${internal_formosa_url}",
            after = "https://github.com/FORMOSA-GPGPU/formosa",
            regex_groups = {
                "internal_formosa_url": "(git@|ssh://git@|https://)(git\\.caslab|elite)\\.ee\\.ncku\\.edu\\.tw[:/][^\\s\"')]*formosa(\\.git)?",
            },
            paths = glob(["**"]),
        ),
    ], reversal = [], noop_behavior = "IGNORE_NOOP"),
    core.transform([
        core.replace(
            before = "${internal_url_line}",
            after = "",
            regex_groups = {
                "internal_url_line": "[^\\n]*(git\\.caslab|elite|wiki\\.caslab)\\.ee\\.ncku\\.edu\\.tw[^\\n]*\\n?",
            },
            paths = glob(["**"]),
        ),
    ], reversal = [], noop_behavior = "IGNORE_NOOP"),
]

core.workflow(
    name = "public_mirror",
    mode = "ITERATIVE",
    origin = git.origin(
        url = GITLAB_REPO,
        ref = "refs/heads/formosa/main",
        first_parent = False,
        submodules = "NO",
    ),
    destination = git.destination(
        url = GITHUB_REPO,
        fetch = "formosa/main",
        push = "formosa/main",
    ),
    origin_files = glob(["**"], exclude = INTERNAL_ONLY_EXCLUDES),
    destination_files = glob(["**"]),
    authoring = authoring.pass_thru("FORMOSA Copybara <copybara@formosa-gpgpu.invalid>"),
    transformations = PUBLIC_TRANSFORMATIONS,
)
